# Copy to .env; supply generated values, never commit a populated file.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DATABASE_URL=postgresql://healthsync_app:REPLACE@127.0.0.1:54322/healthsync
PII_KEY_ID=local-v1
# Each key is an independent, random, base64-encoded 32-byte value.
PII_KEY_BASE64=
EMAIL_HMAC_KEY_BASE64=
VAULT_SIGNING_KEY_BASE64=
CORS_ORIGINS=["http://localhost:5173"]
# Optional locally; REQUIRED for authenticated production workflows.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
AUTH_AUDIENCE=authenticated
# Phase 2: private S3-compatible bucket with SSE-KMS and public access blocked.
VAULT_BUCKET=
VAULT_REGION=us-east-1
VAULT_KMS_KEY_ID=
# Equipo: envíos DESACTIVADOS por defecto; habilitar solo con autorización.
STAFF_EMAIL_SEND_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
STAFF_EMAIL_FROM=
# URL HTTPS exacta de la clínica/tenant correcto, sin query ni fragmento.
STAFF_ACCEPT_URL=
